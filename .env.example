# Скопируй этот файл в .env и впиши свои значения. Файл .env никому не отправляй.
# Ключ Steam: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
# Токен STRATZ: https://stratz.com/api
STRATZ_TOKEN=
# Необязательно: ключ OpenDota снимает общий лимит запросов, когда сайтом пользуются многие
OPENDOTA_API_KEY=
# Необязательно: тренер на нейросети. Без ключа сайт пишет разбор сам, бесплатно.
# Ключ и каталог из Yandex AI Studio: https://aistudio.yandex.ru
AI_API_KEY=
AI_FOLDER_ID=
# Сколько новых разборов в день разрешено, защита бюджета
AI_DAILY_LIMIT=100
# Необязательно: сообщение в Telegram, когда на сайте посмотрели ПТС
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PORT=3000
# Для размещения в интернете:
# HOST=0.0.0.0
# TRUST_PROXY=1
